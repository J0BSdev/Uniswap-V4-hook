{
  "name": "dynamic-lp-fees-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "env -u VITE_HOOK_ADDRESS -u VITE_POOL_ID -u VITE_SWAP_ROUTER -u VITE_LP_TICK_LOWER -u VITE_LP_TICK_UPPER -u VITE_BASE_RPC_URL -u VITE_DEV_PRIVATE_KEY -u VITE_CHAIN_ID vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_BASE_PATH=/Uniswap-V4-hook/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
