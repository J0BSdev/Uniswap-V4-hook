# Default local dev — Base Sepolia testnet (see .env.development).
#   cd frontend && npm run dev
#
# Local anvil fork (optional):
#   bash script/setup-fork.sh && cd frontend && npm run dev:fork
#   Writes frontend/.env.fork.local
#
# Production (Vercel): frontend/.env.production
#
# Full Sepolia re-deploy + seed:
#   PRIVATE_KEY=0x... ./script/setup-sepolia.sh

# 84532 = Base Sepolia (default dev), 8453 = Base mainnet / fork
VITE_CHAIN_ID=84532

VITE_HOOK_ADDRESS=
VITE_POOL_ID=
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_ETH_USD_FEED=
VITE_POOL_MANAGER=
VITE_SWAP_ROUTER=
VITE_LP_TICK_LOWER=
VITE_LP_TICK_UPPER=

# FORK ONLY (npm run dev:fork) — never commit real keys
VITE_DEV_PRIVATE_KEY=

VITE_WALLETCONNECT_PROJECT_ID=
