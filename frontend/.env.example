# Copy to .env.local and fill in once the hook is deployed on Base.
# While these are empty the app runs in DEMO mode (simulated pool + oracle).
#
# Quick Base Sepolia setup (from repo root):
#   PRIVATE_KEY=0x... ./script/setup-sepolia.sh

# 8453 = Base mainnet, 84532 = Base Sepolia
VITE_CHAIN_ID=8453

# Deployed DynamicLPFeesHook address on Base mainnet
VITE_HOOK_ADDRESS=

# The poolId (bytes32) of the WETH/USDC dynamic-fee pool that uses the hook
VITE_POOL_ID=

# Base RPC endpoint (defaults to the public Base RPC if empty)
VITE_BASE_RPC_URL=

# Base Sepolia only — mock ETH/USD feed from DeployBaseSepolia.s.sol
VITE_ETH_USD_FEED=
# Base Sepolia PoolManager (auto-set by setup-sepolia.sh)
VITE_POOL_MANAGER=

# Uniswap V4 Universal Router on Base (needed for real swaps; demo mode ignores it)
VITE_UNIVERSAL_ROUTER=

# WalletConnect project id (optional; only needed for the WalletConnect connector)
VITE_WALLETCONNECT_PROJECT_ID=

# FORK/DEV ONLY — do not set in production.
# PoolSwapTest router address (from SeedLiquidity script) for real on-chain swaps.
VITE_SWAP_ROUTER=
# A funded dev private key (e.g. default anvil key) so the swap card can sign swaps
# without a browser wallet. NEVER use a real key here.
VITE_DEV_PRIVATE_KEY=

# Tick bounds of the seeded LP position (logged by SeedLiquidity.s.sol).
VITE_LP_TICK_LOWER=
VITE_LP_TICK_UPPER=
